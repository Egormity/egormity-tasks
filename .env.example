# Used by the development launcher. This is the repository Codex works on.
OPERATIONS_AGENT_REPOSITORY=/absolute/path/to/working/repository
# Administrator identity service; no platform source packages are imported.
OPERATIONS_AGENT_API_URL=http://localhost:3000
# Every agent message, Codex response and account connection requires a Telegram code.
# Existing bot delivery through Gateway. Empty credentials block these actions.
OPERATIONS_AGENT_TELEGRAM_URL=
OPERATIONS_AGENT_TELEGRAM_TOKEN=
OPERATIONS_AGENT_TELEGRAM_CHAT_ID=-1004381042765
OPERATIONS_AGENT_TELEGRAM_THREAD_ID=210
# Local defaults: web 5176, API 3010, Codex bridge 3011.
# Codex reuses CODEX_HOME or ~/.codex, including your existing login and native history.
# Optional override for a separate account/profile:
# OPERATIONS_AGENT_CODEX_HOME=/absolute/path/to/separate/codex-home

# One instruction file for all chats, including assessment of attached board tasks.
# Repository AGENTS.md and the selected Codex profile still apply.
OPERATIONS_AGENT_INSTRUCTIONS_FILE=src/agent/instructions/agent.md

# SSH runs where the Agent runs. Trust host keys in this file before connecting.
# Default locally: ~/.ssh/known_hosts. Container: /run/agent-ssh/known_hosts.
# OPERATIONS_AGENT_SSH_KNOWN_HOSTS=/absolute/path/to/known_hosts

# Main server. Leave HOST, USER and credentials empty to disable the connection.
OPERATIONS_AGENT_SSH_MAIN_HOST=
OPERATIONS_AGENT_SSH_MAIN_PORT=22
OPERATIONS_AGENT_SSH_MAIN_USER=
OPERATIONS_AGENT_SSH_MAIN_DIRECTORY=/var/www/amazi-main
# Select a private key, password, or existing SSH agent/default OpenSSH keys.
OPERATIONS_AGENT_SSH_MAIN_IDENTITY_FILE=
OPERATIONS_AGENT_SSH_MAIN_PASSWORD=

# Gateway server. Paths refer to the filesystem of the Agent process.
OPERATIONS_AGENT_SSH_GATEWAY_HOST=
OPERATIONS_AGENT_SSH_GATEWAY_PORT=22
OPERATIONS_AGENT_SSH_GATEWAY_USER=
OPERATIONS_AGENT_SSH_GATEWAY_DIRECTORY=/var/www/amazi-ai-gateway
OPERATIONS_AGENT_SSH_GATEWAY_IDENTITY_FILE=
OPERATIONS_AGENT_SSH_GATEWAY_PASSWORD=
