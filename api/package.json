{
  "name": "egormity-tasks",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:api && npm run start:api",
    "build": "npm run build:api",
    "build:api": "node build.mjs",
    "start:api": "node dist/api/main.js",
    "migrate:sqlite": "node dist/api/migrate-sqlite.js",
    "typecheck": "tsc6 --noEmit",
    "lint": "eslint src/api && prettier --check src/api",
    "format": "prettier --write src/api",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@eslint/js": "^9.39.1",
    "@radix-ui/react-dialog": "^1.1.20",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.90.11",
    "@testing-library/react": "^16.3.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.2",
    "jsdom": "29.1.1",
    "lucide-react": "^0.555.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.1.13"
  }
}
